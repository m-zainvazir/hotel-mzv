# =============================================================================
# AI Receptionist — environment template
# Copy to `.env` and fill in. NEVER commit `.env`.
# Phase markers refer to §15 of AI-Receptionist-Build-Plan.md.
# =============================================================================

# -----------------------------------------------------------------------------
# App (Phase 1)
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
# Shared secret required on channel endpoints (/chat, /chat/completions).
# Leave blank in development to disable the check.
API_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Reasoning model — Groq (Phase 1)  https://console.groq.com/keys
# -----------------------------------------------------------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# --- Cheaper / alternative models -------------------------------------------
# Two ways to change model, both config-only:
#
# 1. Another model ON Groq — just change GROQ_MODEL above. Cheaper options
#    include `llama-3.1-8b-instant` (a fraction of 70B's price) and
#    `qwen/qwen3-32b`. Check current ids + pricing at console.groq.com/docs/models
#    and https://groq.com/pricing — and re-test tool calling before trusting one,
#    since smaller models are markedly worse at it (plan §17).
#
# 2. A different PROVIDER that speaks the OpenAI API — set LLM_PROVIDER=openai
#    plus the three values below. Requires: pip install -e ".[openai]"
#      DeepSeek   OPENAI_BASE_URL=https://api.deepseek.com/v1        OPENAI_MODEL=deepseek-chat
#      Zhipu/GLM  OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4  OPENAI_MODEL=glm-4-flash
#      Qwen       OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#      OpenRouter OPENAI_BASE_URL=https://openrouter.ai/api/v1
#      Ollama     OPENAI_BASE_URL=http://localhost:11434/v1          (free, local)
#
# The tool-calling critical path is what breaks first on weaker models. Verify
# with a booking conversation before switching a live tenant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# 3. Google Gemini — set LLM_PROVIDER=google. Free-tier limits are far higher
#    than Groq's, and tool calling is solid. Requires: pip install -e ".[google]"
#    Key: https://aistudio.google.com/apikey   Model ids + limits: /aistudio → Models
#    Confirm the exact model id with `python -m scripts.check_model --all`;
#    Flash-Lite variants are the cheapest/fastest with the highest free limits.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash-lite

# -----------------------------------------------------------------------------
# Tenancy (Phase 1 single-tenant → Phase 4 multi-tenant)
# -----------------------------------------------------------------------------
DEFAULT_TENANT_ID=hotel-mzv
TENANT_CACHE_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Voice — Vapi, Custom LLM mode (Phase 2)  https://dashboard.vapi.ai
# -----------------------------------------------------------------------------
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=
# Vapi signs server webhooks with this; verify it before trusting a payload.
VAPI_WEBHOOK_SECRET=
# Public URL Vapi calls back on, e.g. https://xxx.ngrok.app
PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# TTS + voice cloning — Cartesia (Phase 2/4)  https://play.cartesia.ai
# Voice cloning REQUIRES stored written consent. No exceptions — see
# app/tenancy/voice.py; a tenant's voice_id can only be set once a
# voice_consents row exists, enforced both in Python and by a DB trigger.
# -----------------------------------------------------------------------------
CARTESIA_API_KEY=
CARTESIA_DEFAULT_VOICE_ID=
CARTESIA_API_BASE=https://api.cartesia.ai
# Dated API version header. Confirm against docs.cartesia.ai before a real
# clone — a wrong value 400s cleanly and is a one-line fix.
CARTESIA_API_VERSION=2026-03-01
# Separate from every other timeout — a multipart audio upload, not a quick call.
CARTESIA_CLONE_TIMEOUT_SECONDS=60.0

# -----------------------------------------------------------------------------
# STT — Deepgram (Phase 2). Usually billed through Vapi; key only needed if you
# bring your own. https://console.deepgram.com
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=

# -----------------------------------------------------------------------------
# Booking — Cal.com (Phase 3, default provider)  https://app.cal.com
# Free tier issues API keys: Settings → Developer → API Keys → New.
#
# Which provider a TENANT uses is set per-tenant in content/tenants/<id>.json
# (`booking.provider`), not here — this section only holds the shared Cal.com
# credentials. A calcom tenant also needs `booking.event_type_id` (or a
# per-service `event_type_id` override) in its JSON, ideally one event type
# with multiple durations enabled so every service can share it.
#
# IMPORTANT: for a calcom tenant, Cal.com's own event-type schedule governs
# availability — `booking.hours` in the tenant JSON becomes prompt copy only.
# Keep the two in sync by hand.
# -----------------------------------------------------------------------------
CALCOM_API_KEY=
CALCOM_API_BASE=https://api.cal.com/v2
CALCOM_TIMEOUT_SECONDS=15.0
# Cal.com requires an attendee email; phone callers rarely give one, so an
# unsupplied email is synthesized as caller-<digits>@<this domain>. Must
# resolve (Cal.com validates deliverability) — example.com is IANA's
# reserved, always-resolvable domain, and the safe default.
BOOKING_PLACEHOLDER_EMAIL_DOMAIN=example.com

# Deferred: Google Calendar behind the same BookingProvider interface (plan
# §10 alternative). Needs an OAuth consent screen + Google app verification
# for the sensitive Calendar scope before external tenants can use it.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback
# GOOGLE_SERVICE_ACCOUNT_JSON=

# -----------------------------------------------------------------------------
# SMS / telephony — Twilio (Phase 3)  https://console.twilio.com
# US SMS also needs A2P 10DLC registration — start it early, it takes days.
# On a trial account you can only text numbers you've verified.
#
# Which tenants actually send real SMS is set per-tenant in
# content/tenants/<id>.json (`notifications.provider`), not here.
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_API_BASE=https://api.twilio.com
# Preferred over TWILIO_FROM_NUMBER when set — the routing Twilio wants for
# A2P-registered traffic.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
TWILIO_TIMEOUT_SECONDS=8.0

# -----------------------------------------------------------------------------
# Database — Supabase (Phase 4)  https://supabase.com/dashboard
#
# Two doors into the same Postgres instance:
#   - PostgREST (SUPABASE_* below) for jobs/calls/messages/tenants/Vault.
#   - psycopg (DATABASE_URL) for the LangGraph checkpointer only — see below.
# Both are optional: unset SUPABASE_URL keeps the in-memory store active;
# unset DATABASE_URL keeps the in-memory (non-durable) checkpointer active.
# Missing config is a hard boot failure only when APP_ENV=production.
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bypasses RLS — admin paths only (onboarding, sync_tenants.py), never a
# tenant-scoped request. Settings → API.
SUPABASE_SECRET_KEY=
# Legacy HS256 shared secret — mints per-tenant JWTs so RLS policies can read
# auth.jwt() ->> 'tenant_id'. Settings → API → JWT Settings ("Legacy JWT
# secret"). Some newer projects only offer asymmetric signing keys — check
# for this field specifically before relying on it.
SUPABASE_JWT_SECRET=
SUPABASE_TIMEOUT_SECONDS=8.0
# TTL for cached per-tenant secrets read from Vault.
SECRET_CACHE_TTL_SECONDS=300
# "json" (default) reads content/tenants/*.json; "supabase" reads the
# `tenants`/`services` tables instead. Flip only after Step 4 is verified live.
TENANT_SOURCE=json

# LangGraph Postgres checkpointer (durable conversation memory) — optional,
# `pip install -e ".[postgres]"`. MUST be the Supavisor SESSION-mode pooler
# URI (host aws-0-<region>.pooler.supabase.com, port 5432) — never the direct
# db.<ref>.supabase.co host (IPv6-only) and never the 6543 transaction-mode
# port (breaks prepared statements). Settings → Database → Connection string.
DATABASE_URL=
CHECKPOINT_RETENTION_HOURS=48

# -----------------------------------------------------------------------------
# MCP layer (Phase 6)
# -----------------------------------------------------------------------------
MCP_ENABLED=false
MCP_TOOL_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# Chat widget (Phase 5)
# Per-tenant display config (accent color, origins, quick replies) lives in
# content/tenants/<id>.json under "chat" — this section is only the session
# token secret shared across every tenant's widget.
# -----------------------------------------------------------------------------
# HMAC key signing widget session tokens. Leave blank in development — a
# random per-process key is generated instead, so tokens just don't survive
# a restart. Set a real value in production so tokens survive a redeploy.
WIDGET_SESSION_SECRET=
WIDGET_SESSION_TTL_SECONDS=3600
CHAT_TRANSCRIPT_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Observability — LangSmith (optional, recommended)  https://smith.langchain.com
# -----------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-receptionist

# -----------------------------------------------------------------------------
# Avatar (Phase 8, optional)
# -----------------------------------------------------------------------------
TAVUS_API_KEY=
SIMLI_API_KEY=
